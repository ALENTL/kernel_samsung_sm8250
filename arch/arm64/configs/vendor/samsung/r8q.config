# CONFIG_MACH_R8Q_CAN_SINGLE is not set
# CONFIG_MACH_R8Q_CHN_HKX is not set
# CONFIG_MACH_R8Q_CHN_OPEN is not set
CONFIG_MACH_R8Q_EUR_OPEN=y
# CONFIG_MACH_R8Q_KOR_SINGLE is not set
# CONFIG_MACH_R8Q_USA_SINGLE is not set
# CONFIG_MOTOR_DRV_CS40L2X is not set
CONFIG_QCA_CLD_WLAN_PROFILE="default"
CONFIG_RADIX_TREE_MULTIORDER=y
# CONFIG_SEC_SEPARATE_BDFILE is not set
CONFIG_SND_SOC_WM_ADSP=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set
CONFIG_XARRAY_MULTI=y

# Neutron Clang
CONFIG_LTO=y
CONFIG_THINLTO=y
CONFIG_LTO_CLANG=y
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_CLANG_SHADOW is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_SHADOW_CALL_STACK_VMAP is not set
# CONFIG_RELR is not set
# CONFIG_COMPAT_VDSO is not set

# KernelSU
CONFIG_KSU=y
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y
# CONFIG_KSU_KPROBES_KSUD is not set
# CONFIG_KSU_HACK_ARM64_BRANCH_LINK is not set
CONFIG_KSU_LSM_SECURITY_HOOKS=y

CONFIG_KSU_FEATURE_SULOG=y
CONFIG_KSU_FEATURE_ADBROOT=y
CONFIG_KSU_FEATURE_ADBROOT_DEFAULT_ENABLE=y
CONFIG_KSU_HOSTSREDIRECT=y

# CONFIG_KSU_ENABLE_FULL_UID_CHECKS is not set
# CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED is not set
# CONFIG_KSU_NOPRINTK is not set
# CONFIG_KSU_SHELL_HAS_SU_ALWAYS is not set
# CONFIG_KSU_DEBUG is not set

CONFIG_KSU_HEURISTIC_IN_TREE_BUILD=y

# NoMount
CONFIG_NOMOUNT=y

# Baseband-Guard
CONFIG_BBG=y
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set

# LSM initialization
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf,baseband_guard"

# KernelSU SUSFS
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_SUS_MEMFD=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
