CONFIG_SS_VIBRATOR=y
CONFIG_SUPPORT_LIGHT_DUALIZATION=y
CONFIG_SUPPORT_STK33610_FACTORY=y
CONFIG_SUPPORT_UNDER_PANEL_WITH_LIGHT_SENSOR=y
CONFIG_TOUCHSCREEN_STM_FTS5CU56A=y
CONFIG_TOUCHSCREEN_ZINITIX_ZT7650=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TX_5V_DISABLE=y
CONFIG_USE_CAMERA_HW_BIG_DATA=y
